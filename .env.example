# Web app URL of the Google Apps Script attached to the careers sheet (see docs/google-sheet-apps-script.js).
# Ends in /exec. Without it, openings come from src/data/jobs.ts and applications fall back to WhatsApp.
NEXT_PUBLIC_SHEET_URL=

# Public address of the live site, no trailing slash (used for link previews and search-engine data).
NEXT_PUBLIC_SITE_URL=
